# ==========================================
# PromoBot - Configuração de Ambiente
# ==========================================

# Aplicação
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Banco de Dados (PostgreSQL)
DATABASE_URL=postgresql+asyncpg://promobot:promosecret123@postgres:5432/promobot
DATABASE_URL_SYNC=postgresql://promobot:promosecret123@postgres:5432/promobot

# Redis (Fila de Tarefas e Deduplicação)
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_NAME=promobot:raw_messages
REDIS_DEDUP_PREFIX=promobot:dedup:
DEDUP_WINDOW_HOURS=24

# Telegram MTProto & Bot API
# Obtenha API_ID e API_HASH em https://my.telegram.org
# (opcional: deixe sem valor para iniciar apenas a base)
# TELEGRAM_API_ID=
TELEGRAM_API_HASH=
# Token do bot para publicação (gerado pelo @BotFather)
TELEGRAM_BOT_TOKEN=
# String de sessão de usuário (opcional, para ouvir canais privados onde o bot não é admin)
TELEGRAM_SESSION_STRING=
TELEGRAM_SESSION_NAME=promobot_session

# Canais de Origem e Destino
# Separados por vírgula (ex: @canal1,@canal2,-1001928374)
TELEGRAM_SOURCE_CHATS=
# Canal ou grupo de destino (ex: @meu_canal_ofertas ou -1001234567890)
TELEGRAM_TARGET_CHAT=

# Afiliados
AMAZON_TAG=
MERCADOLIVRE_TAG=
SHOPEE_APP_ID=
SHOPEE_TAG=

# Filtros
MIN_DISCOUNT_PERCENT=0.0
# (opcional: deixe sem valor para não aplicar piso/teto de preço)
# MIN_PRICE=
# MAX_PRICE=
ALLOWED_STORES=
BLOCKED_STORES=
ALLOWED_CATEGORIES=
BLOCKED_CATEGORIES=
BLOCKED_KEYWORDS=esgotado,sorteio,rifa,fake,esgotada,golpe
REQUIRED_KEYWORDS=
