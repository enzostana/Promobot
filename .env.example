# ==========================================
# PromoBot - Configuração de Ambiente
# ==========================================
#
# SECRETS: Valores sensíveis devem ser colocados em arquivos em ./secrets/
# com permissão 600. O docker-compose monta esses arquivos em /run/secrets/.
# Veja ./secrets/README.md para detalhes.
#
# Exemplo:
#   echo "sua_senha_segura" > ./secrets/postgres_password.txt
#   chmod 600 ./secrets/postgres_password.txt

# Aplicação
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO

# Banco de Dados (PostgreSQL) - componentes (senha via secret)
POSTGRES_USER=promobot
POSTGRES_DB=promobot
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# POSTGRES_PASSWORD é lido do secret: ./secrets/postgres_password.txt

# Redis (Fila de Tarefas e Deduplicação)
REDIS_URL=redis://redis:6379/0
REDIS_QUEUE_NAME=promobot:raw_messages
REDIS_DEDUP_PREFIX=promobot:dedup:
DEDUP_WINDOW_HOURS=24
WORKER_MAX_ATTEMPTS=3

# Telegram MTProto & Bot API
# Obtenha API_ID e API_HASH em https://my.telegram.org
TELEGRAM_API_ID=
# TELEGRAM_API_HASH lido do secret: ./secrets/telegram_api_hash.txt
# TELEGRAM_BOT_TOKEN lido do secret: ./secrets/telegram_bot_token.txt
# TELEGRAM_SESSION_STRING lido do secret: ./secrets/telegram_session_string.txt (opcional)
TELEGRAM_SESSION_NAME=promobot_session

# Canais de Origem e Destino
# Separados por vírgula (ex: @canal1,@canal2,-1001928374)
TELEGRAM_SOURCE_CHATS=
# Canal ou grupo de destino (ex: @meu_canal_ofertas ou -1001234567890)
TELEGRAM_TARGET_CHAT=

# Afiliados (lidos de secrets se não definidos aqui)
# AMAZON_TAG lido do secret: ./secrets/amazon_tag.txt
# MERCADOLIVRE_TAG lido do secret: ./secrets/mercadolivre_tag.txt
# SHOPEE_APP_ID lido do secret: ./secrets/shopee_app_id.txt
# SHOPEE_TAG lido do secret: ./secrets/shopee_tag.txt

# Dashboard Authentication (Basic Auth)
# DASHBOARD_USERNAME=admin
# DASHBOARD_PASSWORD=senha_segura

# Cloudflare Tunnel (criar em https://dash.cloudflare.com/ -> Zero Trust -> Networks -> Tunnels)
# CLOUDFLARE_TUNNEL_TOKEN=

# Filtros
MIN_DISCOUNT_PERCENT=0.0
# (opcional: deixe sem valor para não aplicar piso/teto de preço)
# MIN_PRICE=
# MAX_PRICE=
ALLOWED_STORES=
BLOCKED_STORES=amazon
ALLOWED_CATEGORIES=
BLOCKED_CATEGORIES=
BLOCKED_KEYWORDS=esgotado,sorteio,rifa,fake,esgotada,golpe
REQUIRED_KEYWORDS=